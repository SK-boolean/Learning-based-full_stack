{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access for learners, mentors, and administrators.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address."
        },
        "role": {
          "type": "string",
          "enum": ["learner", "mentor", "admin"],
          "description": "Assigned user role."
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the user."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation."
        },
        "lastLoginAt": {
          "type": "string",
          "description": "ISO timestamp of last login."
        }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profile and assigned role (learner, mentor, admin)."
    }
  }
}
